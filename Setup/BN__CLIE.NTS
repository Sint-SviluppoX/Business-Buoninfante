<nts>
<use_ assembly="BN__SCTE.DLL"/>
<reference assembly="BN__CLIE.dll"/>
<scriptCode><![CDATA[
Imports Microsoft.VisualBasic
Imports System
Imports System.Data
Imports NTSInformatica.CLN__STD
Imports NTSInformatica
Imports NTSInformatica.FRM__CLIE
'Imports System.Data.SqlClient
Public Class BN__CLIEVBS 
    Implements INT__SCRIPT
  Dim frmParent as FRM__CHIL 'FRM__CLIE
  Public Function Exec(ByVal strCommand As String, byref oApp as Object, ByRef oIn As Object, ByRef oParam As Object) as Object Implements INT__SCRIPT.Exec
    Try
	    Select Case strCommand
           Case "InitControls":         InitControls(oIn, oApp)
           Case "ed_hhCodDestExc_Validated": ControllaCodiceDestinazioneExcel(oIn, oApp)
	    End Select
	    Return Nothing
    Catch ex As Exception
       Dim strErr As String = CLN__STD.GestError(ex, nothing, "", oApp.InfoError, oApp.ErrorLogFile, True)
       Return Nothing
    End Try
  End Function
 Sub InitControls(ByRef oIn As Object, ByRef oApp As Object)
  Try
	    frmParent = oIn
    Catch ex As Exception
       Dim strErr As String = CLN__STD.GestError(ex, nothing, "", oApp.InfoError, oApp.ErrorLogFile, True)
    End Try
  End Sub
  Sub ControllaCodiceDestinazioneExcel(ByRef oIn As Object, ByRef oApp As Object)
    Dim controllo As NTSTextBoxNum = Nothing
    Dim frmDesg As FRM__DESG = Nothing
    Dim rigaCorrente As DataRow = Nothing
    Dim duplicato As DataTable = Nothing
    Try
      controllo = CType(oIn, NTSTextBoxNum)
      frmDesg = CType(frmParent, FRM__DESG)
      Dim vistaCorrente As DataRowView = CType(frmDesg.dcDesg.Current, DataRowView)
      If vistaCorrente Is Nothing Then Return
      rigaCorrente = vistaCorrente.Row
      Dim codiceEsterno As Integer = NTSCInt(controllo.Text)
      If codiceEsterno <= 0 Then Return
      Dim ditta As String = NTSCStr(rigaCorrente!codditt)
      Dim conto As Integer = NTSCInt(rigaCorrente!dd_conto)
      Dim codDestCorrente As Integer = NTSCInt(rigaCorrente!dd_coddest)
      'Cerco lo stesso codice Excel su un'altra destinazione dello stesso conto e della stessa ditta.
      Dim strSQL As String = "SELECT TOP 1 dd_coddest FROM DESTDIV" &
                             " WHERE codditt = " & CStrSQL(ditta) &
                             " AND dd_conto = " & conto.ToString() &
                             " AND dd_hhCodDestExc = " & codiceEsterno.ToString() &
                             " AND dd_coddest <> " & codDestCorrente.ToString() &
                             " ORDER BY dd_coddest"
      duplicato = frmDesg.oCleClie.oCldClie.OpenRecordset(strSQL, CLE__APP.DBTIPO.DBAZI)
      If duplicato Is Nothing OrElse duplicato.Rows.Count = 0 Then Return
      Dim codDestDuplicato As Integer = NTSCInt(duplicato.Rows(0)!dd_coddest)
      'Ripristino sia il controllo sia il campo del DataRow già aggiornato dal binding.
      Dim valorePrecedente As Object = controllo.OldEditValue
      controllo.EditValue = valorePrecedente
      If valorePrecedente Is Nothing OrElse Convert.IsDBNull(valorePrecedente) OrElse
         NTSCStr(valorePrecedente).Trim() = "" OrElse NTSCInt(valorePrecedente) <= 0 Then
        rigaCorrente!dd_hhCodDestExc = DBNull.Value
      Else
        rigaCorrente!dd_hhCodDestExc = NTSCInt(valorePrecedente)
      End If
      oApp.MsgBoxExclamation("Il codice destinazione Excel " & codiceEsterno.ToString() &
                             " è già associato alla destinazione " & codDestDuplicato.ToString() &
                             " del conto " & conto.ToString() & ".")
    Catch ex As Exception
      Dim strErr As String = CLN__STD.GestError(ex, Nothing, "", oApp.InfoError, oApp.ErrorLogFile, True)
    End Try
  End Sub

End Class

]]></scriptCode>
</nts>
